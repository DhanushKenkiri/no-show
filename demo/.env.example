# WalletConnect Cloud project id — free, https://cloud.walletconnect.com
# Required by RainbowKit. Without it, injected wallets still work but every
# mobile wallet (i.e. the demo) does not. Set this on Vercel too.
NEXT_PUBLIC_WC_PROJECT_ID=

# The organiser / deployer / x402 payee address. Must match the key in the
# Foundry keystore used to deploy, or finalize reverts NotOrganiser.
NEXT_PUBLIC_ORGANISER_ADDRESS=0xA02f986810602163f078e38488C6FE6756De606e

# Set after Prompt 2's deploy.
NEXT_PUBLIC_NOSHOW_ADDRESS=
